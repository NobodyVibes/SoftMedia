# OS
.DS_Store
Thumbs.db

# SoftMedia Specific
# Anchored to the repo root (leading slash): these ignore the TOP-LEVEL runtime media/data
# folders ONLY. Without the leading slash, "media/" and "data/" also matched SOURCE directories
# named Media/Data (e.g. src/SoftMedia.Server/Services/Media, src/SoftMedia.Server/Data) —
# case-insensitively on Windows — silently hiding source files. The unanchored "data/" rule had
# excluded AppDbContext.cs / AppDbContextFactory.cs / DbInitializer.cs from git entirely.
/media/
/data/
# Runtime artifacts that live alongside the now-tracked Data-layer source.
/src/SoftMedia.Server/Data/backups/
/src/SoftMedia.Server/Data/task-status.json
*.db
*.db-shm
*.db-wal
# Pre-restore DB snapshots — the ".pre-restore-<timestamp>" suffix escapes the *.db rule above
# and previously leaked four full snapshots (with user password hashes) into git. See R-WI-001,
# docs/plans/remediation-and-gap-closure-plan-2026-07-15.md.
*.db.pre-restore-*
transcode-temp/
**/cache/
**/wwwroot/cache/
test-fixtures/

# Test / build output noise (never commit; see Phase 2 / E1 of the hardening plan,
# and R-WI-001 in docs/plans/remediation-and-gap-closure-plan-2026-07-15.md which purged the rest)
**/build*.log
**/build*.txt
**/test_log*.txt
**/test_run_*.txt
**/test_build_*.txt
**/test_*.txt
**/test_*.log
**/test_results*.txt
**/errors.log
**/ef_errors*.txt
**/dump.txt
**/dunedump.*
**/*.trx

# Credentials & tokens — never commit (R-WI-001 removed the tracked copies; rotate any that leaked).
# login.json held admin/admin123; token.json held an admin JWT.
login.json
token.json

# Ad-hoc local diagnostic scripts — keep them out of git by convention.
**/*.local.ps1
image_test.ps1
library_test.ps1
music_diagnostic.ps1

# Vendored ffmpeg removed from git (see docs/plans/licensing-and-repo-hygiene-plan-2026-06-18.md).
# jellyfin-ffmpeg is fetched at setup time, not committed. These rules prevent re-vendoring.
/src/SoftMedia.Server/ffmpeg-bin/
/src/SoftMedia.Server/ffmpeg.exe.bak
/src/SoftMedia.Server/ffprobe.exe.bak
*.exe.bak
/src/SoftMedia.Server/ffmpeg.exe
/src/SoftMedia.Server/ffprobe.exe

# History-purge follow-up (2026-07-21): these bloated the repo to 5.3 GiB and broke every
# push (GitHub HTTP 500). Purged from all history with git filter-repo; rules prevent return.
/example-media/
/src/SoftMedia.Server/test_transcode/
/src/SoftMedia.Server/test_hw/
/src/SoftMedia.Server/test_sw_manual/
/src/SoftMedia.Server/test_media.mkv
/src/SoftMedia.Server/test_noseek.mp4
*.log
