{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "DefaultConnection": "Data Source=softmedia.db"
    },
    "Cors": {
        "AllowedOrigins": [
            "http://localhost:5173",
            "http://127.0.0.1:5173"
        ],
        "AllowAnyOriginForLAN": false
    },
    "JwtSettings": {
        "Secret": "",
        "Issuer": "SoftMediaServer",
        "Audience": "SoftMediaClient",
        "ExpiryMinutes": "15",
        "CastTokenExpiryHours": "12"
    },
    "OMDb": {
        "SoftMediaApiKey": "SOFTMEDIA_OMDB_KEY_PLACEHOLDER"
    },
    "ForwardedHeaders": {
        "TrustedProxies": [],
        "TrustedProxyNetworks": []
    },
    "Security": {
        "ForceHttpsRedirect": false
    }
}